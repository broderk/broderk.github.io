---
import { postsPageHref } from '../utils/browse';

interface Props { page: number; totalPages: number; totalPosts: number; }
const { page, totalPages, totalPosts } = Astro.props;
---
<div class="pagination-block">
  <p class="pagination-count">共 {totalPosts} 篇文章 · 第 {page} / {totalPages} 页</p>
  {totalPages > 1 && (
    <nav class="pagination" aria-label="文章分页">
      {page > 1 && <a href={postsPageHref(page - 1)} rel="prev">← 上一页</a>}
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((number) =>
        number === page
          ? <span aria-current="page" aria-label={`第 ${number} 页，当前页`}>{number}</span>
          : <a href={postsPageHref(number)} aria-label={`第 ${number} 页`}>{number}</a>
      )}
      {page < totalPages && <a href={postsPageHref(page + 1)} rel="next">下一页 →</a>}
    </nav>
  )}
</div>
