---
import { getImage } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { siteConfig } from '../config/site';
import { getSiteSettings } from '../config/seo-site.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: { published: Date; updated?: Date; tags: string[] };
}

const { title, description = siteConfig.description, noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const base = Astro.site!;
const canonical = new URL(Astro.url.pathname, base);
canonical.search = '';
canonical.hash = '';
const preview = await getImage({ src: avatar, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const imageUrl = new URL(preview.src, base);
const indexable = getSiteSettings().indexable && !import.meta.env.DEV && !noindex;
const schema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  image: imageUrl.href,
  datePublished: article.published.toISOString(),
  ...(article.updated ? { dateModified: article.updated.toISOString() } : {}),
  author: { '@type': 'Person', name: siteConfig.author, url: new URL('/about/', base).href },
  publisher: { '@type': 'Person', name: siteConfig.author },
  inLanguage: 'zh-CN',
} : null;
const schemaJson = schema ? JSON.stringify(schema).replaceAll('<', '\\u003c') : '';
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content={indexable ? 'index, follow' : 'noindex, follow'} />
<link rel="canonical" href={canonical.href} />
<link rel="sitemap" type="application/xml" href={new URL('/sitemap-index.xml', base).href} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${siteConfig.name}分享预览图`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:image:alt" content={`${siteConfig.name}分享预览图`} />
{article && <>
  <meta property="article:published_time" content={article.published.toISOString()} />
  {article.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
  <meta property="article:author" content={new URL('/about/', base).href} />
  {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
</>}
{schema && <script type="application/ld+json" set:html={schemaJson} />}
