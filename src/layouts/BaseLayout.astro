---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  noindex?: boolean;
  article?: { published: Date; updated?: Date; tags: string[] };
}

const { title, description, wide = false, noindex = false, article } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead title={title} description={description} noindex={noindex} article={article} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/">{siteConfig.name}</a>
        <nav aria-label="主导航"><a href="/posts/">文章</a><a href="/archive/">归档</a><a href="/tags/">标签</a><a href="/search/">搜索</a><a href="/about/">关于</a></nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class:list={["container", "main-content", { "container-wide": wide }]}><slot /></main>
    <footer class="site-footer">
      <div class="container footer-content">
        <span>© {new Date().getFullYear()} {siteConfig.author} · {siteConfig.name}</span>
        <nav aria-label="页脚导航">
          <a href={`mailto:${siteConfig.email}`}>联系我</a>
          <a href="/rss.xml">RSS 订阅</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
