---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 · 页面未找到" description="这个页面不存在或已被移动。返回首页、浏览文章或搜索内容。" noindex>
  <section class="error-page" aria-labelledby="error-title">
    <p class="eyebrow">404 · PAGE NOT FOUND</p>
    <h1 id="error-title">这个页面走丢了</h1>
    <p class="lead">链接可能已失效，或者地址输入有误。可以从首页重新出发，也可以看看最近的文章。</p>
    <nav class="error-actions" aria-label="页面未找到后的导航">
      <a class="button" href="/">返回首页</a>
      <a class="button" href="/posts/">浏览文章</a>
      <a class="button" href="/search/">搜索文章</a>
    </nav>
  </section>
</BaseLayout>
